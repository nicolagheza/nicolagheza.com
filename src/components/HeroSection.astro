---
import { homepage } from "../data/content";
---

<section class="hero">
  <div class="hero__grid-bg"></div>
  <div class="wrap hero__inner">
    <div class="hero__meta">
      {homepage.meta.map((m, i) => (
        <>
          <span class="hero__meta-item">
            {m.dot && <span class="hero__meta-dot"></span>}
            {m.label}
          </span>
          {i < homepage.meta.length - 1 && <span class="hero__meta-sep" aria-hidden="true"></span>}
        </>
      ))}
    </div>

    <h1 class="hero__title">
      <span id="hero-name">{homepage.heading}</span><span id="hero-cursor" class="cursor"></span>
    </h1>

    <p class="hero__bio" set:html={homepage.bio} />

    <div class="hero__cta">
      {homepage.links.map((link) => (
        <a
          href={link.href}
          target={link.external ? "_blank" : undefined}
          rel={link.external ? "noopener noreferrer" : undefined}
          class={`btn btn--${link.variant}`}
        >
          {link.label}
        </a>
      ))}
    </div>

    <aside class="hero__annotation" aria-hidden="true">// status: ok
↳ no LLMs
   harmed.</aside>
  </div>
</section>

<script>
  document.addEventListener("astro:page-load", () => {
    const el = document.getElementById("hero-name");
    const cursor = document.getElementById("hero-cursor");
    if (!el || !cursor) return;

    const names = ["Nicola Gheza", "NICODE"];
    let current = 0;
    let animating = false;

    function typeText(text: string, onDone: () => void) {
      let i = 0;
      el!.textContent = "";
      const interval = setInterval(() => {
        el!.textContent = text.slice(0, i + 1);
        i++;
        if (i >= text.length) {
          clearInterval(interval);
          onDone();
        }
      }, 60);
    }

    function deleteText(onDone: () => void) {
      const text = el!.textContent || "";
      let i = text.length;
      const interval = setInterval(() => {
        i--;
        el!.textContent = text.slice(0, i);
        if (i <= 0) {
          clearInterval(interval);
          onDone();
        }
      }, 40);
    }

    function cycle() {
      if (animating) return;
      animating = true;
      cursor!.classList.add("cursor--typing");
      deleteText(() => {
        current = (current + 1) % names.length;
        typeText(names[current], () => {
          animating = false;
          cursor!.classList.remove("cursor--typing");
        });
      });
    }

    setInterval(cycle, 5000);
  });
</script>
