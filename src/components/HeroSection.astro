---
import { homepage } from "../data/content";
---

<section class="min-h-[calc(100vh-65px)] flex items-center justify-center px-6 py-20">
  <div class="max-w-3xl text-center">
    <h1 class="font-semibold text-[clamp(2.5rem,7vw,4.5rem)] leading-[1.1] tracking-tight mb-6 animate-[fadeInUp_0.6s_var(--ease-smooth)_both]">
      <span id="hero-name">{homepage.heading}</span><span class="text-accent animate-[blink_1s_ease-in-out_infinite]">_</span>
    </h1>

    <div class="flex flex-wrap justify-center gap-3 mt-6 mb-8 animate-[fadeInUp_0.6s_var(--ease-smooth)_0.15s_both]">
      {homepage.subtitles.map((sub) => (
        <span class="text-sm font-medium px-4 py-1.5 rounded-full border border-border text-text-secondary hover:border-accent hover:text-accent transition-colors duration-200">
          {sub.text}
        </span>
      ))}
    </div>

    <p class="text-sm font-medium uppercase tracking-[0.2em] text-text-muted mt-6 animate-[fadeInUp_0.6s_var(--ease-smooth)_0.25s_both]">
      {homepage.tagline}
    </p>

    <p class="text-base text-text-secondary leading-relaxed max-w-xl mx-auto mt-6 mb-10 animate-[fadeInUp_0.6s_var(--ease-smooth)_0.35s_both]" set:html={homepage.bio} />

    <div class="flex gap-3 justify-center flex-wrap mt-8 animate-[fadeInUp_0.6s_var(--ease-smooth)_0.45s_both]">
      {homepage.links.map((link, i) => (
        <a
          href={link.href}
          target={link.external ? "_blank" : undefined}
          rel={link.external ? "noopener noreferrer" : undefined}
          class:list={[
            "inline-flex items-center text-sm font-medium px-6 py-3 rounded-md transition-all duration-200",
            i === 0
              ? "bg-accent text-white hover:bg-accent-hover"
              : "border border-border text-text hover:border-text hover:bg-surface",
          ]}
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</section>

<script>
  document.addEventListener("astro:page-load", () => {
    const el = document.getElementById("hero-name");
    if (!el) return;

    const names = ["Nicola Gheza", "NICODE"];
    let current = 0;
    let animating = false;

    function typeText(text: string, onDone: () => void) {
      let i = 0;
      el!.textContent = "";
      const interval = setInterval(() => {
        el!.textContent = text.slice(0, i + 1);
        i++;
        if (i >= text.length) {
          clearInterval(interval);
          onDone();
        }
      }, 60);
    }

    function deleteText(onDone: () => void) {
      const text = el!.textContent || "";
      let i = text.length;
      const interval = setInterval(() => {
        i--;
        el!.textContent = text.slice(0, i);
        if (i <= 0) {
          clearInterval(interval);
          onDone();
        }
      }, 40);
    }

    function cycle() {
      if (animating) return;
      animating = true;
      deleteText(() => {
        current = (current + 1) % names.length;
        typeText(names[current], () => {
          animating = false;
        });
      });
    }

    setInterval(cycle, 5000);
  });
</script>
