---
import { homepage } from "../data/content";
---

<section class="relative grid-bg flex items-center min-h-[calc(100vh-8rem)]">
  <div class="max-w-6xl mx-auto px-6 py-24 md:py-32 w-full">
    <div class="max-w-3xl">
      <div class="eyebrow mb-6 text-[color:var(--color-text-secondary)]">
        <span class="text-[color:var(--color-accent)]">_</span> {homepage.tagline}
      </div>

      <h1 class="font-[var(--font-display)] font-semibold tracking-[-0.02em] text-[clamp(2.5rem,7vw,5rem)] leading-[1.02] text-[color:var(--color-text)]">
        <span id="hero-name">{homepage.heading}</span><span class="cursor-u">_</span>
      </h1>

      <div class="flex flex-wrap gap-2 mt-8">
        {homepage.subtitles.map((sub) => (
          <span class="font-[var(--font-mono)] text-xs uppercase tracking-[0.08em] bracket-label text-[color:var(--color-text-secondary)] py-1.5">
            {sub.text}
          </span>
        ))}
      </div>

      <p class="text-base md:text-lg text-[color:var(--color-text-secondary)] leading-relaxed max-w-2xl mt-8" set:html={homepage.bio} />

      <div class="flex flex-wrap gap-3 mt-10">
        {homepage.links.map((link, i) => (
          <a
            href={link.href}
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noopener noreferrer" : undefined}
            class:list={[
              "btn-plus",
              i === 0 ? "btn-plus--primary" : i === 1 ? "btn-plus--dark" : "btn-plus--ghost",
            ]}
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener("astro:page-load", () => {
    const el = document.getElementById("hero-name");
    if (!el) return;

    const names = ["Nicola Gheza", "NICODE"];
    let current = 0;
    let animating = false;

    function typeText(text: string, onDone: () => void) {
      let i = 0;
      el!.textContent = "";
      const interval = setInterval(() => {
        el!.textContent = text.slice(0, i + 1);
        i++;
        if (i >= text.length) {
          clearInterval(interval);
          onDone();
        }
      }, 60);
    }

    function deleteText(onDone: () => void) {
      const text = el!.textContent || "";
      let i = text.length;
      const interval = setInterval(() => {
        i--;
        el!.textContent = text.slice(0, i);
        if (i <= 0) {
          clearInterval(interval);
          onDone();
        }
      }, 40);
    }

    function cycle() {
      if (animating) return;
      animating = true;
      deleteText(() => {
        current = (current + 1) % names.length;
        typeText(names[current], () => {
          animating = false;
        });
      });
    }

    setInterval(cycle, 5000);
  });
</script>
