---
interface Props {
  items: readonly string[];
}

const { items } = Astro.props;
const doubled = [...items, ...items];
---

<div class="marquee">
  <div class="marquee__track">
    {doubled.map((item) => (
      <>
        <span class="marquee__item">{item}</span>
        <span class="marquee__sep">+</span>
      </>
    ))}
  </div>
</div>
