---
interface Props {
  items: readonly string[];
}

const { items } = Astro.props;
const doubled = [...items, ...items];
---

<div class="overflow-hidden border-y border-border py-3 whitespace-nowrap bg-bg">
  <div class="inline-flex animate-[marquee_25s_linear_infinite]">
    {doubled.map((item) => (
      <span class="text-xs font-medium uppercase tracking-[0.2em] text-text-muted px-8 shrink-0">
        {item} <span class="text-accent">/</span>
      </span>
    ))}
  </div>
</div>
