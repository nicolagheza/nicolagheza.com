---
interface ProjectLink {
  label: string;
  href: string;
  external: boolean;
}

interface Props {
  title: string;
  type: string;
  description: string;
  color: "blue" | "pink" | "green" | "yellow";
  links: ProjectLink[];
}

const { title, type, description, links } = Astro.props;
---

<div class="corner-frame relative group p-8 bg-[color:var(--color-surface)] h-full flex flex-col transition-colors hover:bg-[color:var(--color-accent-soft)]">
  <span class="corner-frame__bl"></span>
  <span class="corner-frame__br"></span>

  <div class="font-[var(--font-mono)] text-xs text-[color:var(--color-text-muted)] uppercase tracking-[0.1em] mb-4 bracket-label">
    {type}
  </div>

  <h2 class="font-[var(--font-mono)] font-semibold text-xl md:text-2xl tracking-tight mb-4 group-hover:text-[color:var(--color-accent)] transition-colors">
    {title}
  </h2>

  <p class="text-sm text-[color:var(--color-text-secondary)] leading-relaxed mb-8 flex-1">{description}</p>

  <div class="flex gap-3 flex-wrap">
    {links.map((link, i) => (
      <a
        href={link.href}
        target={link.external ? "_blank" : undefined}
        rel={link.external ? "noopener noreferrer" : undefined}
        class:list={[
          "btn-plus",
          i === 0 ? "btn-plus--primary" : "btn-plus--ghost",
        ]}
      >
        {link.label}
      </a>
    ))}
  </div>
</div>
