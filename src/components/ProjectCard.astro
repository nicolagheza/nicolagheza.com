---
import type { Tone } from "../data/content";

interface ProjectLink {
  label: string;
  href: string;
  external: boolean;
}

interface Props {
  tone: Tone;
  title: string;
  type: string;
  description: string;
  visual: string;
  links: ProjectLink[];
}

const { tone, title, type, description, visual, links } = Astro.props;
---

<article class={`proj proj--${tone}`}>
  <div class="proj__visual">
    <span class="proj__visual-mark">{visual.charAt(0)}</span>
  </div>
  <div class="proj__body">
    <div class="proj__type">{type}</div>
    <h2 class="proj__title">{title}</h2>
    <p class="proj__desc">{description}</p>
    <div class="proj__links">
      {links.map((l, i) => (
        <a
          href={l.href}
          target={l.external ? "_blank" : undefined}
          rel={l.external ? "noopener noreferrer" : undefined}
          class={`btn ${i === 0 ? "btn--primary" : "btn--ghost"} btn--sm`}
        >{l.label}</a>
      ))}
    </div>
  </div>
</article>
