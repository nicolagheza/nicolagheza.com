---
import { navigation } from "../data/content";

const year = new Date().getFullYear();

const socials = [
  { label: "GitHub", href: "https://github.com/nicolagheza", external: true },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/nicola-gheza-9995bb116/", external: true },
  { label: "Email", href: "mailto:nicola@nicode.solutions" },
];
---

<footer class="bg-[color:var(--color-dark)] text-[color:var(--color-text-invert)] border-t border-[color:var(--color-border-dark)] mt-0">
  <div class="max-w-6xl mx-auto px-6 py-16 grid grid-cols-1 md:grid-cols-4 gap-10">
    <div class="md:col-span-1">
      <div class="font-[var(--font-mono)] font-semibold text-2xl text-white tracking-tight">
        NICODE<span class="text-[color:var(--color-accent)]">_</span>
      </div>
      <p class="text-xs font-[var(--font-mono)] text-[color:var(--color-text-muted)] mt-3">
        di Gheza Nicola
      </p>
      <p class="text-xs font-[var(--font-mono)] text-[color:var(--color-text-muted)] mt-1">
        P.IVA 04680240985
      </p>
    </div>

    <div>
      <div class="eyebrow text-[color:var(--color-text-muted)] mb-4">PAGES</div>
      <ul class="flex flex-col gap-2">
        {navigation.map(l => (
          <li>
            <a href={l.href} class="text-sm text-[color:var(--color-text-invert)] hover:text-[color:var(--color-accent)] transition-colors">
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <div class="eyebrow text-[color:var(--color-text-muted)] mb-4">CONNECT</div>
      <ul class="flex flex-col gap-2">
        {socials.map(l => (
          <li>
            <a
              href={l.href}
              target={l.external ? "_blank" : undefined}
              rel={l.external ? "noopener noreferrer" : undefined}
              class="text-sm text-[color:var(--color-text-invert)] hover:text-[color:var(--color-accent)] transition-colors"
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <div class="eyebrow text-[color:var(--color-text-muted)] mb-4">CONTACT</div>
      <a href="mailto:nicola@nicode.solutions" class="text-sm text-[color:var(--color-text-invert)] hover:text-[color:var(--color-accent)] transition-colors block">
        nicola@nicode.solutions
      </a>
    </div>
  </div>

  <div class="border-t border-[color:var(--color-border-dark)]">
    <div class="max-w-6xl mx-auto px-6 py-6">
      <p class="text-xs font-[var(--font-mono)] text-[color:var(--color-text-muted)]">
        &copy; {year} NICODE di Gheza Nicola. All rights reserved.
      </p>
    </div>
  </div>
</footer>
