---
const year = new Date().getFullYear();
const links = [
  { label: "Email", href: "mailto:nicode.solutions@gmail.com" },
  { label: "GitHub", href: "https://github.com/nicolagheza" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/nicola-gheza-9995bb116/" },
];
---

<footer class="border-t border-border mt-24">
  <div class="max-w-5xl mx-auto px-6 py-12">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-8">
      <div>
        <p class="font-semibold text-lg tracking-tight text-text">
          NICODE<span class="text-accent">.</span> <span class="font-normal text-sm text-text-muted">di Gheza Nicola</span>
        </p>
        <p class="text-sm text-text-muted mt-1">
          P.IVA: 04680240985
        </p>
      </div>

      <div class="flex gap-6">
        {links.map((link) => (
          <a
            href={link.href}
            target={link.href.startsWith("mailto") ? undefined : "_blank"}
            rel={link.href.startsWith("mailto") ? undefined : "noopener noreferrer"}
            class="text-sm text-text-secondary hover:text-accent transition-colors duration-200"
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>

    <div class="border-t border-border-subtle mt-8 pt-8">
      <p class="text-xs text-text-muted">
        &copy; {year} NICODE di Gheza Nicola. All rights reserved.
      </p>
    </div>
  </div>
</footer>
