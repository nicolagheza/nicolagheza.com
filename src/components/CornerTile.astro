---
interface Props {
  class?: string;
  as?: "div" | "a";
  href?: string;
  external?: boolean;
}
const { class: cls = "", as = "div", href, external = false } = Astro.props;
const Tag = as;
const commonClass = `corner-frame relative p-8 bg-[color:var(--color-surface)] ${cls}`;
---
{as === "a" ? (
  <a
    href={href}
    class={commonClass}
    target={external ? "_blank" : undefined}
    rel={external ? "noopener noreferrer" : undefined}
  >
    <span class="corner-frame__bl"></span>
    <span class="corner-frame__br"></span>
    <slot />
  </a>
) : (
  <Tag class={commonClass}>
    <span class="corner-frame__bl"></span>
    <span class="corner-frame__br"></span>
    <slot />
  </Tag>
)}
