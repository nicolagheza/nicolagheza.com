---
import { navigation } from "../data/content";

interface Props {
  currentPage: string;
}

const { currentPage } = Astro.props;
---

<nav class="sticky top-0 z-50 bg-white/80 backdrop-blur-lg border-b border-border">
  <div class="max-w-5xl mx-auto flex items-center justify-center px-6 py-4">
    <!-- Mobile hamburger -->
    <button
      id="nav-toggle"
      class="md:hidden flex flex-col gap-1.5 p-2 rounded-md hover:bg-surface transition-colors duration-200"
      aria-label="Toggle navigation"
      aria-expanded="false"
    >
      <span class="block w-5 h-[1.5px] bg-text rounded-full"></span>
      <span class="block w-5 h-[1.5px] bg-text rounded-full"></span>
      <span class="block w-5 h-[1.5px] bg-text rounded-full"></span>
    </button>

    <!-- Desktop links -->
    <div id="nav-links" class="hidden md:flex gap-1 items-center">
      {navigation.map((item) => (
        <a
          href={item.href}
          class:list={[
            "text-sm font-medium px-4 py-2 rounded-md transition-colors duration-200",
            currentPage === item.href
              ? "text-accent bg-accent-light"
              : "text-text-secondary hover:text-text hover:bg-surface",
          ]}
        >
          {item.label}
        </a>
      ))}
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-border bg-white px-4 pb-4">
    {navigation.map((item) => (
      <a
        href={item.href}
        class:list={[
          "block text-sm font-medium text-center py-3 px-4 rounded-md transition-colors duration-200 mb-1",
          currentPage === item.href
            ? "text-accent bg-accent-light"
            : "text-text-secondary hover:text-text hover:bg-surface",
        ]}
      >
        {item.label}
      </a>
    ))}
  </div>
</nav>

<script>
  document.addEventListener("astro:page-load", () => {
    const toggle = document.getElementById("nav-toggle");
    const menu = document.getElementById("mobile-menu");
    if (toggle && menu) {
      toggle.addEventListener("click", () => {
        const isOpen = !menu.classList.contains("hidden");
        menu.classList.toggle("hidden");
        toggle.setAttribute("aria-expanded", String(!isOpen));
      });
    }
  });
</script>
