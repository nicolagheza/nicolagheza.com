---
interface Props {
  title: string;
  focus: string;
  details: string[];
  impact: string;
  color: "blue" | "pink" | "green" | "yellow";
}

const { title, focus, details, impact } = Astro.props;
---

<div class="group border border-border rounded-lg p-6 hover:border-accent/30 hover:bg-accent-light/30 transition-all duration-300">
  <h3 class="font-semibold text-base mb-2 group-hover:text-accent transition-colors duration-200">
    {title}
  </h3>
  <p class="text-sm text-text-secondary leading-relaxed mb-4">
    {focus}
  </p>
  <div class="flex flex-wrap gap-2 mb-4">
    {details.map((tag) => (
      <span class="text-xs font-medium text-text-muted bg-surface px-3 py-1 rounded-full">
        {tag}
      </span>
    ))}
  </div>
  <p class="text-sm text-text-secondary leading-relaxed">
    {impact}
  </p>
</div>
