---
interface Props {
  title: string;
  focus: string;
  details: string[];
  impact: string;
  color: "blue" | "pink" | "green" | "yellow";
}

const { title, focus, details, impact } = Astro.props;
---

<div class="corner-frame relative group p-8 bg-[color:var(--color-surface)] transition-colors hover:bg-[color:var(--color-accent-soft)]">
  <span class="corner-frame__bl"></span>
  <span class="corner-frame__br"></span>

  <h3 class="font-[var(--font-mono)] font-semibold text-lg tracking-tight mb-3 group-hover:text-[color:var(--color-accent)] transition-colors">
    {title}
  </h3>
  <p class="text-sm text-[color:var(--color-text-secondary)] leading-relaxed mb-5">
    {focus}
  </p>
  <div class="flex flex-wrap gap-2 mb-5">
    {details.map((tag) => (
      <span class="font-[var(--font-mono)] text-xs text-[color:var(--color-text-secondary)] bg-[color:var(--color-surface-2)] px-3 py-1 rounded-full bracket-label">
        {tag}
      </span>
    ))}
  </div>
  <p class="text-sm text-[color:var(--color-text-secondary)] leading-relaxed">
    {impact}
  </p>
</div>
