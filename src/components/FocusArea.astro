---
import type { Tone } from "../data/content";

interface Props {
  tone: Tone;
  num: string;
  title: string;
  focus: string;
  details: string[];
  impact: string;
}

const { tone, num, title, focus, details, impact } = Astro.props;
---

<article class={`tile tile--${tone}`}>
  <span class="corner-bl"></span>
  <span class="corner-br"></span>
  <div class="focus">
    <div class="focus__rail">
      <span class="focus__rail-label">{num}</span>
    </div>
    <div class="focus__body">
      <div class="focus__num">/ {num}</div>
      <h3 class="focus__title">{title}</h3>
      <p class="focus__text">{focus}</p>
      <div class="focus__tags">
        {details.map((t) => <span class="focus__tag">{t}</span>)}
      </div>
      <p class="focus__impact">{impact}</p>
    </div>
  </div>
</article>
