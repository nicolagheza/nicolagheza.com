---
interface ServiceItem {
  name: string;
  description: string;
}

interface Props {
  title: string;
  icon: string;
  color: "blue" | "pink" | "green" | "yellow";
  description: string;
  items: ServiceItem[];
}

const { title, icon, description, items } = Astro.props;
---

<div class="group border border-border rounded-lg p-8 hover:border-accent/30 transition-all duration-300">
  <div class="flex items-center gap-3 mb-2">
    <span class="text-2xl">{icon}</span>
    <h3 class="font-semibold text-lg group-hover:text-accent transition-colors duration-200">{title}</h3>
  </div>
  <p class="text-sm text-text-secondary mb-6">{description}</p>
  <ul class="flex flex-col gap-4">
    {items.map((item) => (
      <li>
        <strong class="text-sm font-medium text-text">{item.name}</strong>
        <span class="block text-sm text-text-muted mt-0.5">{item.description}</span>
      </li>
    ))}
  </ul>
</div>
