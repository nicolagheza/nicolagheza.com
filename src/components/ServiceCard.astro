---
import type { Tone } from "../data/content";

interface ServiceItem {
  name: string;
  description: string;
}

interface Props {
  tone: Tone;
  title: string;
  icon: string;
  description: string;
  items: ServiceItem[];
}

const { tone, title, icon, description, items } = Astro.props;
---

<article class={`tile tile--${tone}`}>
  <span class="corner-bl"></span>
  <span class="corner-br"></span>
  <div class="svc">
    <div class="svc__head">
      <div class="svc__icon">{icon}</div>
      <div>
        <h3 class="svc__title">{title}</h3>
        <p class="svc__desc">{description}</p>
      </div>
    </div>
    <ul class="svc__items">
      {items.map((it, i) => (
        <li class="svc__item">
          <span class="svc__item-num">{String(i + 1).padStart(2, "0")}</span>
          <div>
            <h4 class="svc__item-name">{it.name}</h4>
            <p class="svc__item-desc">{it.description}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</article>
