---
import type { Tone } from "../data/content";

interface Props {
  tone: Tone;
  role: string;
  company: string;
  details?: string;
  description?: string;
  location: string;
  dates: string;
}

const { tone, role, company, details, description, location, dates } = Astro.props;

const MONTH_ABBR: Record<string, string> = {
  january: "Jan", february: "Feb", march: "Mar", april: "Apr",
  may: "May", june: "Jun", july: "Jul", august: "Aug",
  september: "Sep", october: "Oct", november: "Nov", december: "Dec",
};
const formatMonthYear = (raw: string) => {
  const s = raw.trim();
  if (!s) return "";
  if (/present|now/i.test(s)) return "Present";
  const m = s.match(/^([A-Za-z]+)\s+(\d{4})$/);
  if (m) {
    const mon = MONTH_ABBR[m[1].toLowerCase()] ?? m[1];
    return `${mon} ${m[2]}`;
  }
  return s;
};
const [startRaw, endRaw] = dates.split(/\s*[-–]\s*/);
const from = formatMonthYear(startRaw ?? "");
const to = formatMonthYear(endRaw ?? "");
---

<div class={`xp xp--${tone}`}>
  <div>
    <h3 class="xp__role">
      {role} <em>@ {company}</em>
      {details && <span class="xp__role-extra">&nbsp;({details})</span>}
    </h3>
    <div class="xp__meta">{location}</div>
    {description && <p class="xp__desc">{description}</p>}
  </div>
  <div class="xp__dates">
    <span class="xp__dates-from">{from}</span>
    <span class="xp__dates-to">→ {to}</span>
  </div>
</div>
