---
import { customers } from "../data/content";
---

<section class="px-6 py-12">
  <div class="max-w-3xl mx-auto text-center">
    <div data-reveal class="mb-8">
      <h2 class="font-heading font-extrabold text-3xl inline-block px-5 py-2 bg-brutal-yellow text-brutal-black border-4 border-brutal-black rounded-xl shadow-brutal-md hover:-translate-y-1 hover:rotate-2 hover:shadow-brutal-lg transition-all duration-300 ease-bounce">
        Customers
      </h2>
    </div>

    <div class="flex flex-wrap justify-center gap-6">
      {customers.map((customer, i) => (
        <div data-reveal data-reveal-delay={String(i + 1)}>
          <div class="group bg-white border-4 border-brutal-black rounded-brutal-md shadow-brutal-md hover:-translate-y-1.5 hover:shadow-brutal-lg active:translate-y-0.5 active:shadow-brutal-sm transition-all duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)] flex items-center justify-center p-6 w-[180px] h-[100px]">
            <img
              src={customer.logo}
              alt={customer.name}
              class="max-w-full max-h-full object-contain grayscale group-hover:grayscale-0 transition-all duration-300"
            />
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
