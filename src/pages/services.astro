---
import BaseLayout from "../layouts/BaseLayout.astro";
import ServiceCard from "../components/ServiceCard.astro";
import { services } from "../data/content";
---

<BaseLayout title="Services" currentPage="/services">
  <div class="max-w-5xl mx-auto px-6 py-16">

    <h1 class="font-semibold text-4xl tracking-tight mb-4 animate-[fadeInUp_0.6s_var(--ease-smooth)_both]">
      Services<span class="text-accent">.</span>
    </h1>

    <p class="text-base text-text-secondary leading-relaxed max-w-2xl mb-12 animate-[fadeInUp_0.6s_var(--ease-smooth)_0.1s_both]">
      {services.intro}
    </p>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-16">
      {services.categories.map((cat, i) => (
        <div data-reveal data-reveal-delay={String(i + 1)}>
          <ServiceCard
            title={cat.title}
            icon={cat.icon}
            color={cat.color}
            description={cat.description}
            items={cat.items.map(item => ({ name: item.name, description: item.description }))}
          />
        </div>
      ))}
    </div>

    <div class="border border-border rounded-lg p-12 text-center" data-reveal>
      <h2 class="font-semibold text-2xl tracking-tight mb-3">{services.cta.text}</h2>
      <p class="text-base text-text-secondary mb-8">{services.cta.subtext}</p>
      <a
        href={services.cta.href}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center text-sm font-medium px-8 py-3 bg-accent text-white rounded-md hover:bg-accent-hover transition-colors duration-200"
      >
        {services.cta.label} &rarr;
      </a>
    </div>
  </div>
</BaseLayout>
