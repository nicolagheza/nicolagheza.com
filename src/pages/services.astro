---
import BaseLayout from "../layouts/BaseLayout.astro";
import ServiceCard from "../components/ServiceCard.astro";
import { services } from "../data/content";

const deliverableCount = services.categories.reduce((sum, c) => sum + c.items.length, 0);
---

<BaseLayout title="Services" currentPage="/services">
  <section class="phead">
    <div class="wrap">
      <div class="phead__kicker">_ Services</div>
      <h1 class="phead__title">Services<span class="cursor"></span></h1>
      <div class="phead__counter">
        <b>{services.categories.length.toString().padStart(2, "0")}</b> disciplines<br/>
        <b>{deliverableCount}</b> deliverables
      </div>
      <p class="phead__lead">{services.intro}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="grid-2">
        {services.categories.map((cat, i) => (
          <div data-reveal data-reveal-delay={String(i + 1)}>
            <ServiceCard
              tone={cat.tone}
              title={cat.title}
              icon={cat.icon}
              description={cat.description}
              items={cat.items.map((it) => ({ name: it.name, description: it.description }))}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="cta__bg"></div>
    <div class="wrap cta__inner">
      <div class="cta__eyebrow">/ let's talk</div>
      <h2 class="cta__title">{services.cta.text}<span class="cursor"></span></h2>
      <p class="cta__sub">{services.cta.subtext}</p>
      <a
        href={services.cta.href}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn--primary"
        style="padding: 14px 22px; font-size: 13px;"
      >{services.cta.label}</a>
    </div>
  </section>
</BaseLayout>
