---
import BaseLayout from "../layouts/BaseLayout.astro";
import FocusArea from "../components/FocusArea.astro";
import ExperienceItem from "../components/ExperienceItem.astro";
import { about } from "../data/content";
---

<BaseLayout title="About" currentPage="/about">
  <div class="max-w-5xl mx-auto px-6 py-16">

    <h1 class="font-semibold text-4xl tracking-tight mb-4 animate-[fadeInUp_0.6s_var(--ease-smooth)_both]">
      About<span class="text-accent">.</span>
    </h1>

    <div class="max-w-2xl mb-16 animate-[fadeInUp_0.6s_var(--ease-smooth)_0.1s_both]">
      {about.bio.map((paragraph) => (
        <p class="text-base text-text-secondary leading-relaxed mb-4 last:mb-0" set:html={paragraph} />
      ))}
    </div>

    <h2 class="font-semibold text-2xl tracking-tight mb-6" data-reveal>
      Focus Areas
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-16">
      {about.focusAreas.map((area, i) => (
        <div data-reveal data-reveal-delay={String(i + 1)}>
          <FocusArea title={area.title} focus={area.focus} details={area.details} impact={area.impact} color={area.color} />
        </div>
      ))}
    </div>

    <h2 class="font-semibold text-2xl tracking-tight mb-6" data-reveal>
      Experience
    </h2>

    <div class="flex flex-col gap-3">
      {about.experience.map((exp, i) => (
        <div data-reveal data-reveal-delay={String(Math.min(i + 1, 6))}>
          <ExperienceItem
            number={exp.number}
            role={exp.role}
            company={exp.company}
            details={exp.details}
            description={exp.description}
            location={exp.location}
            dates={exp.dates}
            color={exp.color}
          />
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
