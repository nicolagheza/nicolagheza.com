---
import BaseLayout from "../layouts/BaseLayout.astro";
import FocusArea from "../components/FocusArea.astro";
import ExperienceItem from "../components/ExperienceItem.astro";
import { about } from "../data/content";
---

<BaseLayout title="About" currentPage="/about">
  <section class="phead">
    <div class="wrap">
      <div class="phead__kicker">_ About</div>
      <h1 class="phead__title">About<span class="cursor"></span></h1>
      <div class="phead__counter">
        <b>01 · 03</b><br/>
        Identity / Focus / Timeline
      </div>
      <div class="phead__split">
        <div>
          {about.bio.map((p) => (
            <p class="phead__lead" set:html={p} />
          ))}
        </div>
        <div class="phead__split-right">
          <div class="status">
            <span class="status__dot"></span>
            {about.status}
          </div>
          <dl class="meta-dl">
            {about.meta.map((m) => (
              <>
                <dt>{m.k}</dt>
                <dd>{m.v}</dd>
              </>
            ))}
          </dl>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section__head">
        <div>
          <div class="eyebrow">/ what I do</div>
          <h2 class="section__title">Focus Areas<span class="cursor"></span></h2>
        </div>
        <p class="section__intro">
          Four disciplines, color-coded across the site. Experience entries and project tags below
          inherit the same palette.
        </p>
      </div>
      <div class="grid-2">
        {about.focusAreas.map((f, i) => (
          <div data-reveal data-reveal-delay={String(i + 1)}>
            <FocusArea tone={f.tone} num={f.num} title={f.title} focus={f.focus} details={f.details} impact={f.impact} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--no-border">
    <div class="wrap">
      <div class="section__head">
        <div>
          <div class="eyebrow">/ timeline</div>
          <h2 class="section__title">Experience<span class="cursor"></span></h2>
        </div>
        <p class="section__intro">
          Six roles, 2017 → present — shipping at the intersection of AI, backend, and data.
        </p>
      </div>

      <div class="timeline">
        {about.experience.map((x, i) => (
          <div data-reveal data-reveal-delay={String(Math.min(i + 1, 6))}>
            <ExperienceItem
              tone={x.tone}
              role={x.role}
              company={x.company}
              details={x.details}
              description={x.description}
              location={x.location}
              dates={x.dates}
            />
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
