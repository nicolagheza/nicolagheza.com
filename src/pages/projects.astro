---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/content";
---

<BaseLayout title="Projects" currentPage="/projects">
  <section class="phead">
    <div class="wrap">
      <div class="phead__kicker">_ Projects</div>
      <h1 class="phead__title">Projects<span class="cursor"></span></h1>
      <div class="phead__counter">
        <b>{projects.length.toString().padStart(2, "0")}</b> selected<br/>
        More on GitHub →
      </div>
      <p class="phead__lead">
        A small, curated set — personal and academic work alongside client engagements.
      </p>
    </div>
  </section>

  <section class="section section--no-border">
    <div class="wrap proj-grid">
      {projects.map((p, i) => (
        <div data-reveal data-reveal-delay={String(i + 1)}>
          <ProjectCard
            tone={p.tone}
            title={p.title}
            type={p.type}
            description={p.description}
            visual={p.visual}
            links={p.links.map((l) => ({ label: l.label, href: l.href, external: l.external }))}
          />
        </div>
      ))}

      <div class="callout">
        <div>
          <div class="eyebrow" style="margin-bottom: 8px;">/ in the workshop</div>
          <h3 class="callout__title">More projects coming soon.</h3>
          <p class="callout__sub">
            Most of my recent work has been under client NDA. For a fuller picture, see GitHub or reach out directly.
          </p>
        </div>
        <div style="display: flex; gap: 8px; flex-shrink: 0;">
          <a href="https://github.com/nicolagheza" target="_blank" rel="noopener noreferrer" class="btn btn--dark btn--sm">GitHub</a>
          <a href="mailto:nicola@nicode.solutions" class="btn btn--primary btn--sm">Email Me</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
