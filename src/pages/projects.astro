---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/content";
---

<BaseLayout title="Projects" currentPage="/projects">
  <div class="max-w-5xl mx-auto px-6 py-16">

    <h1 class="font-semibold text-4xl tracking-tight mb-8 animate-[fadeInUp_0.6s_var(--ease-smooth)_both]">
      Projects<span class="text-accent">.</span>
    </h1>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
      {projects.map((project, i) => (
        <div data-reveal data-reveal-delay={String(i + 1)}>
          <ProjectCard
            title={project.title}
            type={project.type}
            description={project.description}
            color={project.color}
            links={project.links.map(l => ({ label: l.label, href: l.href, external: l.external }))}
          />
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
